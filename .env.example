# Neon Postgres and Object Storage: `neon deploy` pulls DATABASE_URL and AWS_* values.
# Required on Vercel; omit DATABASE_URL for persistent local demo storage.
DATABASE_URL=
NEON_STORAGE_BUCKET=assets
ADMIN_EMAIL=admin@churicanvas.com
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional direct connection for initial schema creation
DATABASE_URL_UNPOOLED=
# Cloud photo uploads (required with PostgreSQL/Vercel)
NEON_STORAGE_BUCKET=assets
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
